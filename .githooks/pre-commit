#!/bin/sh
set -eu
if ! command -v gitleaks >/dev/null 2>&1; then
  printf '%s\n' 'Gitleaks is required before committing. Install it from https://github.com/gitleaks/gitleaks (macOS: brew install gitleaks).' >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner --ignore-gitleaks-allow
